FROM golang:1.27.3-trixie@sha256:af1bfc2614ebb1dbd31af514b78740fd678850e76498762b425ecee4c5c6ea80 AS builder

# GCC 14.2 ICEs in peephole2 on large legacy C translation units.
ENV GOTOOLCHAIN=local \
    GOEXPERIMENT="" \
    CGO_CFLAGS="-O2 -g -fno-peephole2"

ARG UID=1000
ARG GID=1000
ARG GIT_SHA=""
ARG GIT_TAG=""

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --gid $GID runner && \
    useradd --home-dir /home/runner --no-create-home --gid runner --uid $UID --shell /bin/sh runner

WORKDIR /home/runner/opennox

COPY go.mod go.sum ./
COPY third_party/go-openal/go.mod ./third_party/go-openal/
COPY third_party/opennox-libs/go.mod third_party/opennox-libs/go.sum ./third_party/opennox-libs/

# The Docker context is src, so recreate the module selection from the root workspace.
RUN test "$(go env GOVERSION)" = "$(awk '$1 == "toolchain" { print $2 }' go.mod)" && \
    go work init . ./third_party/opennox-libs && \
    go mod download

COPY . .

RUN go run ./internal/noxbuild server && ./opennox-server -h


FROM debian:trixie AS server

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /home/runner/opennox/opennox-server /usr/bin/opennox-server

RUN opennox-server -h

VOLUME /nox/

EXPOSE 22/tcp
EXPOSE 18590/udp
EXPOSE 18590/tcp
EXPOSE 6060/tcp

WORKDIR /nox/
ENTRYPOINT ["opennox-server", "--rcon=:22"]

FROM server AS demo

RUN apt update && \
    apt upgrade -y && \
    apt install -y curl unzip cabextract && \
    apt-get autoremove -y && apt-get clean -y cache

ADD --checksum=sha256:ba01f1b43ff1d95f4cd2ab63abe4572e9b26ab22f1b7bd8b99d852fba6607eec https://archive.org/download/NoxDemo/noxdemo.exe /tmp/noxdemo.exe
RUN unzip /tmp/noxdemo.exe -d /tmp/noxdemo && rm /tmp/noxdemo.exe

RUN cabextract /tmp/noxdemo/Install/Game1.CAB -d /nox && rm -rf /tmp/noxdemo
ENV NOX_CHAT_MAP=so_woods
